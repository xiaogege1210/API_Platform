                        },
                        "query": {
                            "member_id_type": "open_id"
                        },
                        "headers": {
                            "Authorization": "Bearer <valid_access_token>"
                        }
                    },
                    "Expectations": [
                        "状态码为400",
                        "响应体code字段为非0的错误码（例如参考文档中的232006）",
                        "响应体msg字段包含错误提示关键字，如'chat_id which is invalid'或'无效的群ID'"
                    ]
                }
            ],
            "ExpectedResults": [
                "接口返回明确的参数错误",
                "错误信息能指导调用方修正chat_id参数"
            ]
        },
