                        "响应体msg字段包含错误提示关键字，如'page_size'、'maximum'、'100'或'超出限制'"
                    ]
                }
            ],
            "ExpectedResults": [
                "接口返回参数验证错误",
                "错误信息明确提示page_size超出允许范围"
            ]
