/button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 测试用例网格 -->\r\n    <div id=\"testcaseGrid\" class=\"grid grid-cols-1 xl:grid-cols-2 gap-6\">\r\n      <!-- 动态内容 -->\r\n    </div>\r\n\r\n    <!-- 底部翻页 -->\r\n    <div class=\"flex justify-center mt-6\" id=\"paginationControlsBottom\" style=\"display: none;\">\r\n      <button onclick=\"changePage(-1)\" class=\"px-4 py-2 bg-white border border-slate-300 rounded-l-lg hover:bg-slate-50 text-slate-600 disabled:opacity-50\">上一页</button>\r\n      <span id=\"pageInfoBottom\" class=\"px-4 py-2 bg-slate-50 border-t border-b border-slate-300 text-slate-600 font-medium\">1 / 1</span>\r\n      <button onclick=\"changePage(1)\" class=\"px-4 py-2 bg-white border border-slate-300 rounded-r-lg hover:bg-slate-50 text-slate-600 disabled:opacity-50\">下一页</button>\r\n    </div>\r\n\r\n    <!-- 分析结果面板 -->\r\n    <div id=\"analysisSection\" class=\"hidden bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl text-white p-8 shadow-xl mt-8\">\r\n      <div class=\"flex justify-between items-start mb-8\">\r\n        <div>\r\n          <h4 class=\"text-xl font-bold flex items-center gap-2\"><i class=\"fas fa-chart-pie text-cyan-400\"></i> AI 分析报告</h4>\r\n          <p class=\"text-slate-400 text-sm mt-1\">基于当前选中的代码生成</p>\r\n        </div>\r\n        <div class=\"text-right\">\r\n          <div class=\"text-5xl font-bold text-emerald-400\" id=\"coverageScoreDisplay\">0</div>\r\n          <div class=\"text-xs text-slate-400 uppercase font-bold tracking-widest mt-1\">覆盖评分</div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\r\n        <div class=\"bg-white/10 rounded-xl p-6 backdrop-blur-sm border border-white/10\">\r\n          <h5 class=\"font-bold text-slate-200 mb-4 border-b border-white/10 pb-2 flex items-center gap-2\">\r\n            <i class=\"fas fa-tachometer-alt\"></i> 基础指标\r\n          </h5>\r\n          <div class=\"space-y-4\">\r\n            <div class=\"flex justify-between items-center\">\r\n              <span class=\"text-slate-300\">总代码行数</span>\r\n              <span id=\"totalLines\" class=\"font-mono text-xl font-bold text-cyan-300\">0</span>\r\n            </div>\r\n            <div class=\"flex justify-between items-center\">\r\n              <span class=\"text-slate-300\">测试方法数</span>\r\n              <span id=\"testMethodCount\" class=\"font-mono text-xl font-bold text-cyan-300\">0</span>\r\n            </div>\r\n            <div class=\"flex justify-between items-center\">\r\n              <span class=\"text-slate-300\">断言总数</span>\r\n              <span id=\"assertionCount\" class=\"font-mono text-xl font-bold text-cyan-300\">0</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"bg-white/10 rounded-xl p-6 backdrop-blur-sm border border-white/10\">\r\n          <h5 class=\"font-bold text-amber-300 mb-4 border-b border-white/10 pb-2 flex items-center gap-2\">\r\n            <i class=\"fas fa-lightbulb\"></i> 智能建议\r\n          </h5>\r\n          <ul id=\"suggestionsList\" class=\"text-sm space-y-3 text-slate-300 list-none\">\r\n            <!-- 动态内容 -->\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</div>\r\n\r\n<!-- 加载动画 -->\r\n<div id=\"loading-modal\" class=\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden z-50 flex items-center justify-center\">\r\n  <div class=\"bg-white p-8 rounded-2xl shadow-2xl flex flex-col items-center transform scale-100 transition-transform\">\r\n    <div class=\"animate-spin rounded-full h-14 w-14 border-[5px] border-indigo-100 border-t-indigo-600 mb-5\"></div>\r\n    <p class=\"text-slate-700 font-bold text-lg animate-pulse\">正在处理...</p>\r\n    <p class=\"text-slate-500 text-sm mt-2\">AI 正在生成/分析数据，请稍候</p>\r\n  </div>\r\n</div>\r\n\r\n<!-- 消息提示容器 -->\r\n<div id=\"toast-container\" class=\"fixed top-24 right-5 z-50 space-y-3 pointer-events-none\"></div>\r\n\r\n<!-- ================= 脚本部分 ================= -->\r\n<script>\r\n  // --- 全局变量定义 ---\r\n  let allApiData = [];\r\n  let ApiData_text = null;\r\n  let currentTestCases = [];\r\n  let generatedTestData = null;\r\n  let currentPage = 1;\r\n  const casesPerPage = 6;\r\n  let scenarioName = \"search_chats_api\";\r\n\r\n  // --- 初始化事件 ---\r\n  document.addEventListener('DOMContentLoaded', function() {\r\n    // 文件输入框美化逻辑\r\n    const fileInput = document.getElementById('fileInput');\r\n    const uploadBox = document.getElementById('uploadBox');\r\n    const uploadFileName = document.getElementById('uploadFileName');\r\n\r\n    fileInput.addEventListener('change', function(e) {\r\n      if (this.files && this.files.length > 0) {\r\n        const files = Array.from(this.files);\r\n        uploadBox.classList.remove('border-dashed', 'border-slate-300', 'bg-slate-50');\r\n        uploadBox.classList.add('border-solid', 'border-indigo-500', 'bg-indigo-50/50', 'shadow-inner');\r\n        \r\n        let fileListHtml = '<div class=\"flex flex-col items-center animate-pulse\"><i class=\"fas fa-file-code text-indigo-600 text-3xl mb-2\"></i>';\r\n        fileListHtml += `<span class=\"font-bold text-slate-800 text-lg mb-2\">已选择 ${files.length} 个文件</span>`;\r\n        fileListHtml += '<div class=\"space-y-1 max-h-40 overflow-y-auto w-full px-4\">';\r\n        \r\n        files.forEach(file => {\r\n          fileListHtml += `\r\n            <div class=\"bg-white px-3 py-2 rounded border border-indigo-100 shadow-sm flex justify-between items-center\">\r\n              <span class=\"text-sm font-medium text-slate-800 truncate max-w-xs\">${file.name}</span>\r\n              <span class=\"text-xs text-slate-500\">${(file.size / 1024).toFixed(2)} KB</span>\r\n            </div>`;\r\n        });\r\n        \r\n        fileListHtml += '</div></div>';\r\n        uploadFileName.innerHTML = fileListHtml;\r\n      } else {\r\n        uploadBox.classList.add('border-dashed', 'border-slate-300', 'bg-slate-50');\r\n        uploadBox.classList.remove('border-solid', 'border-indigo-500', 'bg-indigo-50/50', 'shadow-inner');\r\n        uploadFileName.innerHTML = '点击此处选择文件 或 拖拽文件到这里';\r\n      }\r\n    });\r\n\r\n    // 状态恢复逻辑\r\n    const urlParams = new URLSearchParams(window.location.search);\r\n    if (urlParams.get('restore') === 'true') {\r\n      restoreAppState();\r\n      window.history.replaceState({}, document.title, \"/\");\r\n    }\r\n  });\r\n\r\n  // ================= 核心导航逻辑 =================\r\n\r\n  // 处理步骤跳转\r\n  function navigateToStep(targetStep) {\r\n    if (targetStep === 2 && allApiData.length === 0) {\r\n      return showStatusMessage(\"请先在第一步上传并解析文档！\", 'warning');\r\n    }\r\n    if (targetStep === 3 && currentTestCases.length === 0) {\r\n      return showStatusMessage(\"请先生成测试用例！\", 'warning');\r\n    }\r\n\r\n    document.getElementById('uploadSection').classList.add('hidden');\r\n    document.getElementById('configSection').classList.add('hidden');\r\n    document.getElementById('testCaseSection').classList.add('hidden');\r\n\r\n    if (targetStep === 1) document.getElementById('uploadSection').classList.remove('hidden');\r\n    if (targetStep === 2) document.getElementById('configSection').classList.remove('hidden');\r\n    if (targetStep === 3) document.getElementById('testCaseSection').classList.remove('hidden');\r\n\r\n    updateStepUI(targetStep);\r\n  }\r\n\r\n  function updateStepUI(step) {\r\n    const items = document.querySelectorAll('.step-item');\r\n    items.forEach(item => {\r\n      const itemStep = parseInt(item.dataset.step);\r\n      const circle = item.querySelector('span');\r\n      if (itemStep <= step) {\r\n        item.className = 'flex items-center text-indigo-600 font-bold step-item step-clickable';\r\n        circle.className = 'w-8 h-8 flex items-center justify-center border-2 border-indigo-600 rounded-full mr-2 bg-indigo-50';\r\n        if(itemStep < step) {\r\n          circle.innerHTML = '<i class=\"fas fa-check\"></i>';\r\n          circle.className = 'w-8 h-8 flex items-center justify-center border-none bg-indigo-600 text-white rounded-full mr-2';\r\n        } else {\r\n          circle.innerHTML = itemStep;\r\n        }\r\n      } else {\r\n        item.className = 'flex items-center text-slate-400 font-medium step-item step-clickable';\r\n        circle.className = 'w-8 h-8 flex items-center justify-center border-2 border-slate-300 rounded-full mr-2 bg-white';\r\n        circle.innerHTML = itemStep;\r\n      }\r\n    });\r\n  }\r\n\r\n  // ================= 业务功能逻辑 =================\r\n\r\n  async function uploadFile(isDirectGenerate = false) {\r\n    const fileInput = document.getElementById('fileInput');\r\n    if (!fileInput.files || fileInput.files.length === 0) return showStatusMessage(\"请先选择文件！\", 'error');\r\n\r\n    const formData = new FormData();\r\n    Array.from(fileInput.files).forEach(file => {\r\n      formData.append(\"files\", file);\r\n    });\r\n\r\n    try {\r\n      showLoading(true);\r\n      if(isDirectGenerate) {\r\n        const toast = document.getElementById('loading-modal').querySelector('p');\r\n        if(toast) toast.innerText = \"正在解析并直接生成用例...\";\r\n      }\r\n\r\n      const res = await fetch('/api/parse', { method: 'POST', body: formData });\r\n      if (!res.ok) throw new Error(\"解析请求失败\");\r\n\r\n      const data = await res.json();\r\n      if (!Array.isArray(data) || data.length === 0) return showStatusMessage(\"返回数据为空！\", 'error');\r\n\r\n      // 合并所有文件的API数据\r\n      allApiData = [];\r\n      ApiData_text = '';\r\n      data.forEach(apiGroup => {\r\n        allApiData = allApiData.concat(apiGroup.apis || []);\r\n        ApiData_text += apiGroup.info || '';\r\n      });\r\n\r\n      renderTable();\r\n\r\n      if (isDirectGenerate) {\r\n        await directGenerate();\r\n      } else {\r\n        navigateToStep(2);\r\n        showStatusMessage(\"解析成功，请配置场景\", 'success');\r\n        showLoading(false);\r\n      }\r\n    } catch (e) {\r\n      console.error(e);\r\n      showStatusMessage(\"操作失败: \" + e.message, 'error');\r\n      showLoading(false);\r\n    }\r\n  }\r\n\r\n  async function directGenerate() {\r\n    const payload = allApiData.map(api => ({\r\n      changjing: `自动生成测试 - ${api.summary || api.path}`,\r\n      user_info: JSON.stringify({ description: \"AI自动生成，请覆盖主要正向和异常路径\" }),\r\n      map_data: ApiData_text\r\n    }));\r\n\r\n    try {\r\n      const res = await fetch('/api/generate', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify(payload)\r\n      });\r\n\r\n      if (!res.ok) throw new Error(\"生成请求失败\");\r\n      const result = await res.json();\r\n\r\n      generatedTestData = result;\r\n      processGeneratedTestCases(result);\r\n      saveAppState();\r\n      navigateToStep(3);\r\n      showStatusMessage(\"智能生成完成！\", 'success');\r\n\r\n    } catch (e) {\r\n      showStatusMessage(\"生成失败: \" + e.message, 'error');\r\n    } finally {\r\n      showLoading(false);\r\n    }\r\n  }\r\n\r\n  async function generateCode() {\r\n    if (!allApiData || Object.keys(allApiData).length === 0) return showStatusMessage(\"请先上传文件！\", 'warning');\r\n    const payload = [];\r\n    document.querySelectorAll('.scenario-box').forEach((box) => {\r\n      const scenarioParams = {};\r\n      box.querySelectorAll('.param-input').forEach(input => {\r\n        const key = input.dataset.key;\r\n        const value = input.value.trim();\r\n        if (value) scenarioParams[key] = value;\r\n      });\r\n      payload.push({\r\n        changjing: box.querySelector('.scenario-name').value.trim() || \"默认场景\",\r\n        user_info: JSON.stringify(scenarioParams),\r\n        map_data: ApiData_text\r\n      });\r\n    });\r\n    if (payload.length === 0) return showStatusMessage(\"请至少添加一个场景！\", 'warning');\r\n\r\n    try {\r\n      showLoading(true);\r\n      const res = await fetch('/api/generate', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify(payload)\r\n      });\r\n      if (!res.ok) throw new Error(\"生成请求失败\");\r\n      const result = await res.json();\r\n\r\n      generatedTestData = result;\r\n      processGeneratedTestCases(result);\r\n      saveAppState();\r\n\r\n      navigateToStep(3);\r\n      showStatusMessage(\"代码生成成功！\", 'success');\r\n    } catch (e) {\r\n      showStatusMessage(\"生成失败: \" + e.message, 'error');\r\n    } finally {\r\n      showLoading(false);\r\n    }\r\n  }\r\n\r\n  // --- UI 渲染辅助函数 ---\r\n\r\n  function renderTable() {\r\n    const tbody = document.getElementById('apiTableBody');\r\n    tbody.innerHTML = '';\r\n    if(allApiData.length === 0) return tbody.innerHTML = '<tr><td colspan=\"4\" class=\"p-4 text-center text-slate-400\">未解析到接口数据</td></tr>';\r\n\r\n    allApiData.forEach((api, index) => {\r\n      const methodColors = { 'GET': 'bg-blue-100 text-blue-700', 'POST': 'bg-emerald-100 text-emerald-700', 'PUT': 'bg-amber-100 text-amber-700', 'DELETE': 'bg-rose-100 text-rose-700' };\r\n      const badgeClass = methodColors[api.method.toUpperCase()] || 'bg-slate-100 text-slate-700';\r\n\r\n      const tr = document.createElement('tr');\r\n      tr.className = \"hover:bg-slate-50 transition-colors group\";\r\n      tr.innerHTML = `\r\n                <td class=\"px-6 py-4 border-b border-slate-50\"><input type=\"checkbox\" class=\"api-checkbox w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer\" data-index=\"${index}\" onchange=\"toggleConfig(${index})\"></td>\r\n                <td class=\"px-6 py-4 border-b border-slate-50\"><span class=\"px-2.5 py-1 text-xs font-bold rounded-md ${badgeClass}\">${api.method}</span></td>\r\n                <td class=\"px-6 py-4 border-b border-slate-50\"><div class=\"font-medium text-slate-700 text-sm font-mono\">${api.path}</div><div class=\"text-xs text-slate-500 mt-1\">${api.summary || '暂无描述'}</div></td>\r\n                <td class=\"px-6 py-4 border-b border-slate-50 text-right\"><button class=\"text-indigo-600 hover:text-indigo-800 text-sm font-medium hover:bg-indigo-50 px-3 py-1 rounded transition\" onclick=\"addScenario(${index})\"><i class=\"fas fa-plus mr-1\"></i> 加场景</button></td>\r\n            `;\r\n      tbody.appendChild(tr);\r\n\r\n      const configTr = document.createElement('tr');\r\n      configTr.id = `config-row-${index}`;\r\n      configTr.className = 'hidden bg-slate-50/50';\r\n      configTr.innerHTML = `<td colspan=\"4\" class=\"p-0\"><div class=\"border-l-4 border-indigo-500 ml-6 my-2 pl-4 pr-6 py-4\" id=\"scenarios-${index}\"></div></td>`;\r\n      tbody.appendChild(configTr);\r\n    });\r\n  }\r\n\r\n  function toggleConfig(index) {\r\n    const checkbox = document.querySelector(`.api-checkbox[data-index=\"${index}\"]`);\r\n    const row = document.getElementById(`config-row-${index}`);\r\n    const container = document.getElementById(`scenarios-${index}`);\r\n    if (checkbox.checked) {\r\n      row.classList.remove('hidden');\r\n      if (container.children.length === 0) addScenario(index);\r\n    } else {\r\n      row.classList.add('hidden');\r\n    }\r\n  }\r\n\r\n  function addScenario(index) {\r\n    const api = allApiData[index];\r\n    const container = document.getElementById(`scenarios-${index}`);\r\n    let paramsHtml = api.parameters && api.parameters.length > 0 ? api.parameters.map(p => `\r\n            <div class=\"flex items-center gap-3 mb-2\">\r\n                <label class=\"w-32 text-xs font-bold text-slate-600 truncate text-right\" title=\"${p.name}\">${p.name} <span class=\"font-normal text-slate-400\">(${p.type})</span></label>\r\n                <input type=\"text\" class=\"scenario-name param-input flex-1 px-3 py-1.5 text-sm border border-slate-300 rounded focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition\" data-key=\"${p.name}\" placeholder=\"${p.in === 'body' ? 'JSON 结构' : '默认值'}\">\r\n                <span class=\"text-xs ${p.required ? 'text-rose-500 font-bold' : 'text-slate-400'} w-12\">${p.required ? '*必填' : '选填'}</span>\r\n            </div>\r\n        `).join('') : '<div class=\"text-xs text-slate-400 italic py-2 text-center\">无参数需配置</div>';\r\n\r\n    const html = `\r\n            <div class=\"scenario-box bg-white p-4 rounded-lg border border-slate-200 shadow-sm mb-3 relative group hover:border-indigo-300 transition-colors\">\r\n                <div class=\"flex items-center justify-between mb-3 border-b border-slate-100 pb-2\">\r\n                    <div class=\"flex items-center gap-2\"><span class=\"bg-indigo-100 text-indigo-700 text-xs px-2 py-0.5 rounded font-bold\">场景</span><input type=\"text\" value=\"新场景\" class=\"scenario-name font-bold text-slate-700 border-none focus:ring-0 p-0 w-40 bg-transparent placeholder-slate-300 focus:text-indigo-600\" placeholder=\"场景名称\"></div>\r\n                    <div class=\"flex items-center gap-4\"><div class=\"flex items-center gap-2 text-xs\"><span class=\"text-slate-500\">预期状态码:</span><input type=\"text\" class=\"expect-code w-12 text-center border border-slate-200 rounded py-0.5 focus:border-indigo-500 outline-none text-slate-700 font-mono\" value=\"200\"></div><button onclick=\"this.closest('.scenario-box').remove()\" class=\"text-slate-400 hover:text-rose-500 transition px-2\"><i class=\"fas fa-trash-alt\"></i></button></div>\r\n                </div>\r\n                <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4\"><div class=\"bg-slate-50 p-3 rounded-md border border-slate-100\">${paramsHtml}</div></div>\r\n            </div>\r\n        `;\r\n    container.insertAdjacentHTML('beforeend', html);\r\n  }\r\n\r\n  // --- 测试用例处理与展示 ---\r\n\r\n  function processGeneratedTestCases(testData) {\r\n    currentTestCases = [];\r\n    const testcaseGrid = document.getElementById('testcaseGrid');\r\n    testcaseGrid.innerHTML = '';\r\n    document.getElementById('scenarioInfoPanel').classList.remove('hidden');\r\n\r\n    if (testData.test_cases) {\r\n      const originalScenarioName = Object.keys(testData.test_cases)[0] || '新场景';\r\n      const scenario = testData.test_cases[originalScenarioName];\r\n      document.getElementById('scenarioNameDisplay').textContent = scenarioName;\r\n      const pos = scenario.PositiveCases ? scenario.PositiveCases.length : 0;\r\n      const neg = scenario.NegativeCases ? scenario.NegativeCases.length : 0;\r\n      document.getElementById('positiveCases').textContent = pos;\r\n      document.getElementById('negativeCases').textContent = neg;\r\n      document.getElementById('totalTestCases').textContent = pos + neg;\r\n    }\r\n\r\n    let javaTestCases = [];\r\n    if (testData.generated_java_code) {\r\n      Object.keys(testData.generated_java_code).forEach(sceneKey => {\r\n        const val = testData.generated_java_code[sceneKey];\r\n        if(Array.isArray(val)) {\r\n          val.forEach((code, idx) => javaTestCases.push({id: generateId(), name: `TestClass_${idx+1}`, code, sceneKey, index: idx}));\r\n        } else if (typeof val === 'object') {\r\n          Object.keys(val).forEach(subKey => {\r\n            if(Array.isArray(val[subKey])) val[subKey].forEach((code, idx) => javaTestCases.push({id: generateId(), name: `TestClass_${idx+1}`, code, sceneKey: subKey, index: idx}));\r\n          });\r\n        }\r\n      });\r\n    }\r\n    updateTestcaseStats(javaTestCases);\r\n    currentTestCases = javaTestCases;\r\n    if (javaTestCases.length === 0) {\r\n      testcaseGrid.innerHTML = '<div class=\"col-span-full text-center py-20 text-slate-400\">未生成 Java 代码</div>';\r\n      return;\r\n    }\r\n    document.getElementById('selectAllContainer').classList.remove('hidden');\r\n    setupPagination();\r\n  }\r\n\r\n  function updateTestcaseStats(testCases) {\r\n    let totalMethods = 0, totalAssertions = 0, totalLines = 0;\r\n    testCases.forEach(tc => {\r\n      totalMethods += (tc.code.match(/@Test/g) || []).length;\r\n      totalAssertions += (tc.code.match(/assert|assertEquals/g) || []).length;\r\n      totalLines += tc.code.split('\\n').length;\r\n    });\r\n    document.getElementById('statTotal').textContent = testCases.length;\r\n    document.getElementById('statMethods').textContent = totalMethods;\r\n    document.getElementById('statAssertions').textContent = totalAssertions;\r\n    document.getElementById('statLines').textContent = totalLines;\r\n    document.getElementById('testcaseStats').classList.remove('hidden');\r\n  }\r\n\r\n  function createTestCaseBox(testCase, index) {\r\n    const classNameMatch = testCase.code.match(/public class (\\w+)/);\r\n    const className = classNameMatch ? classNameMatch[1] : `TestClass_${index+1}`;\r\n    if (!testCase.className) testCase.className = className;\r\n\r\n    const isSelected = document.getElementById(`checkbox-${index}`)?.checked || false;\r\n\r\n    const div = document.createElement('div');\r\n    div.className = `testcase-box bg-white rounded-xl border transition-all duration-200 relative group flex flex-col h-[500px] ${isSelected ? 'border-indigo-500 ring-2 ring-indigo-500/20 shadow-lg' : 'border-slate-200 shadow-sm hover:shadow-md'}`;\r\n    div.dataset.index = index;\r\n    div.dataset.id = testCase.id;\r\n\r\n    div.innerHTML = `\r\n            <div class=\"flex items-center justify-between p-4 border-b border-slate-100 bg-slate-50/50 rounded-t-xl\">\r\n                <div class=\"flex items-center gap-3 overflow-hidden\">\r\n                    <input type=\"checkbox\" id=\"checkbox-${index}\" class=\"testcase-checkbox w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer\" ${isSelected ? 'checked' : ''} onchange=\"updateSelectedCount(); toggleCardStyle(this)\">\r\n                    <div class=\"flex flex-col min-w-0\">\r\n                        <span class=\"font-bold text-slate-700 text-sm truncate flex items-center gap-2\" title=\"${className}\"><i class=\"fab fa-java text-indigo-500 text-lg\"></i> ${className}</span>\r\n                        <span class=\"text-xs text-slate-400 truncate\">场景: ${testCase.sceneKey}</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"flex gap-1 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity\">\r\n                    <button class=\"p-2 text-slate-400 hover:text-indigo-600 hover:bg-white rounded-lg transition\" onclick=\"event.stopPropagation(); editTestCase(${index})\" title=\"编辑\"><i class=\"fas fa-edit\"></i></button>\r\n                    <button class=\"p-2 text-slate-400 hover:text-green-600 hover:bg-white rounded-lg transition\" onclick=\"event.stopPropagation(); saveSingleTestCase(${index})\" title=\"保存到本地\"><i class=\"fas fa-save\"></i></button>\r\n                    <button class=\"p-2 text-slate-400 hover:text-emerald-600 hover:bg-white rounded-lg transition\" onclick=\"event.stopPropagation(); executeSingleTestCase(${index})\" title=\"执行\"><i class=\"fas fa-play\"></i></button>\r\n                    <button class=\"p-2 text-slate-400 hover:text-rose-500 hover:bg-white rounded-lg transition\" onclick=\"event.stopPropagation(); deleteTestCase(${index})\" title=\"删除\"><i class=\"fas fa-trash-alt\"></i></button>\r\n                </div>\r\n            </div>\r\n            <div class=\"relative flex-1 overflow-hidden group/code\">\r\n                <textarea id=\"editor-${index}\" class=\"hidden w-full h-full p-4 font-mono text-xs outline-none resize-none border-2 border-indigo-100 bg-indigo-50/20 text-slate-700\"></textarea>\r\n                <div class=\"testcase-content w-full h-full p-4 overflow-auto code-font text-xs text-slate-600 leading-relaxed whitespace-pre bg-white\" id=\"code-view-${index}\">${escapeHtml(testCase.code)}</div>\r\n                <div id=\"edit-actions-${index}\" class=\"hidden absolute bottom-4 right-4 gap-2\">\r\n                     <button class=\"bg-indigo-600 text-white px-3 py-1 rounded text-xs hover:bg-indigo-700\" onclick=\"saveTestCaseEdit(${index})\">确认修改</button>\r\n                     <button class=\"bg-slate-500 text-white px-3 py-1 rounded text-xs hover:bg-slate-600\" onclick=\"cancelTestCaseEdit(${index})\">取消</button>\r\n                </div>\r\n                <div class=\"execution-result hidden absolute inset-0 bg-white/95 backdrop-blur-sm p-4 z-10 overflow-auto border-t border-slate-100 flex flex-col\"></div>\r\n            </div>\r\n            <div class=\"p-3 border-t border-slate-100 bg-white rounded-b-xl flex justify-between items-center text-xs text-slate-400 font-mono\">\r\n                <div class=\"flex gap-3\"><span><i class=\"fas fa-list-ol mr-1\"></i>${testCase.code.split('\\n').length} 行</span><span><i class=\"fas fa-check-circle mr-1\"></i>${(testCase.code.match(/@Test/g) || []).length} 测试</span></div>\r\n            </div>\r\n        `;\r\n    document.getElementById('testcaseGrid').appendChild(div);\r\n  }\r\n\r\n  // --- 操作功能：保存、执行、删除、分析 ---\r\n\r\n  async function saveSingleTestCase(index) {\r\n    if (index < 0 || index >= currentTestCases.length) return;\r\n    const testCase = currentTestCases[index];\r\n    const classNameMatch = testCase.code.match(/public class (\\w+)/);\r\n    const className = classNameMatch ? classNameMatch[1] : (testCase.className || `TestClass_${index+1}`);\r\n    const filePath = testCase.filePath || `case_generated/${scenarioName}/${className}.java`;\r\n\r\n    try {\r\n      showStatusMessage(`正在保存: ${className}...`, 'info');\r\n      const res = await fetch('/api/testcase/save', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({ filePath: filePath, content: testCase.code })\r\n      });\r\n      const result = await res.json();\r\n      if (result.success) {\r\n        testCase.filePath = filePath;\r\n        testCase.className = className;\r\n        showStatusMessage(`保存成功！路径: ${filePath}`, 'success');\r\n      } else {\r\n        showStatusMessage(`保存失败: ${result.message}`, 'error');\r\n      }\r\n    } catch (e) {\r\n      showStatusMessage(`保存出错: ${e.message}`, 'error');\r\n    }\r\n  }\r\n\r\n  async function saveSelectedTestCases() {\r\n    const checkboxes = document.querySelectorAll('.testcase-checkbox:checked');\r\n    const selectedIndices = Array.from(checkboxes).map(cb => parseInt(cb.id.replace('checkbox-', '')));\r\n    if (selectedIndices.length === 0) return showStatusMessage(\"请至少选择一个测试用例！\", 'warning');\r\n\r\n    const filePaths = [];\r\n    const contents = [];\r\n    selectedIndices.forEach(index => {\r\n      if(index >= 0 && index < currentTestCases.length) {\r\n        const testCase = currentTestCases[index];\r\n        const classNameMatch = testCase.code.match(/public class (\\w+)/);\r\n        const className = classNameMatch ? classNameMatch[1] : (testCase.className || `TestClass_${index+1}`);\r\n        const filePath = testCase.filePath || `case_generated/${scenarioName}/${className}.java`;\r\n        filePaths.push(filePath);\r\n        contents.push(testCase.code);\r\n        testCase.filePath = filePath;\r\n        testCase.className = className;\r\n      }\r\n    });\r\n\r\n    try {\r\n      showStatusMessage(`正在批量保存 ${filePaths.length} 个文件...`, 'info');\r\n      const res = await fetch('/api/testcase/batch/update', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({ filePaths: filePaths, contents: contents })\r\n      });\r\n      const result = await res.json();\r\n      if (result.success) showStatusMessage(`成功保存 ${filePaths.length} 个文件！`, 'success');\r\n      else showStatusMessage(`批量保存失败: ${result.message}`, 'error');\r\n    } catch (e) {\r\n      showStatusMessage(`请求错误: ${e.message}`, 'error');\r\n    }\r\n  }\r\n\r\n  async function executeSingleTestCase(index) {\r\n    const testCase = currentTestCases[index];\r\n    const classNameMatch = testCase.code.match(/public class (\\w+)/);\r\n    const className = classNameMatch ? classNameMatch[1] : (testCase.className || `TestClass_${index+1}`);\r\n    const filePath = testCase.filePath || `case_generated/${scenarioName}/${className}.java`;\r\n\r\n    const box = document.querySelector(`.testcase-box[data-index=\"${index}\"]`);\r\n    const resultDiv = box.querySelector('.execution-result');\r\n    resultDiv.classList.remove('hidden');\r\n    resultDiv.innerHTML = '<div class=\"flex items-center justify-center h-full text-indigo-500\"><i class=\"fas fa-spinner fa-spin mr-2\"></i> 正在执行...</div>';\r\n\r\n    try {\r\n      const res = await fetch('/api/execute/single', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({ testCaseFileName: filePath })\r\n      });\r\n      const result = await res.json();\r\n\r\n      const colorClass = result.passed ? 'text-emerald-600' : 'text-rose-600';\r\n      const iconClass = result.passed ? 'fa-check-circle' : 'fa-times-circle';\r\n\r\n      resultDiv.innerHTML = `\r\n                <div class=\"flex justify-between items-center mb-2 border-b border-slate-100 pb-2\">\r\n                    <span class=\"font-bold ${colorClass}\"><i class=\"fas ${iconClass}\"></i> ${result.passed ? '执行成功' : '执行失败'}</span>\r\n                    <button class=\"text-xs text-slate-400 hover:text-slate-600\" onclick=\"this.closest('.execution-result').classList.add('hidden')\"><i class=\"fas fa-times\"></i></button>\r\n                </div>\r\n                ${result.failureReason ? `<div class=\"text-xs text-rose-500 mb-2 font-bold\">原因: ${result.failureReason}</div>` : ''}\r\n                <div class=\"text-xs font-mono text-slate-600 whitespace-pre-wrap h-[200px] overflow-auto custom-scroll\">${result.outputText || '无输出'}</div>\r\n            `;\r\n      if(result.passed) showStatusMessage(`${className} 执行通过`, 'success');\r\n      else showStatusMessage(`${className} 执行失败`, 'error');\r\n\r\n    } catch (e) {\r\n      resultDiv.innerHTML = `<div class=\"text-rose-500 p-4\">请求出错: ${e.message}</div>`;\r\n    }\r\n  }\r\n\r\n  async function batchExecuteTestCases() {\r\n    const checkboxes = document.querySelectorAll('.testcase-checkbox:checked');\r\n    const selectedIndices = Array.from(checkboxes).map(cb => parseInt(cb.id.replace('checkbox-', '')));\r\n    if (selectedIndices.length === 0) return showStatusMessage(\"请至少选择一个测试用例！\", 'warning');\r\n\r\n    const fileNames = [];\r\n    selectedIndices.forEach(idx => {\r\n      const tc = currentTestCases[idx];\r\n      const cls = tc.code.match(/public class (\\w+)/)[1] || `TestClass_${idx+1}`;\r\n      fileNames.push(tc.filePath || `case_generated/${scenarioName}/${cls}.java`);\r\n    });\r\n\r\n    try {\r\n      showStatusMessage(`正在批量执行 ${fileNames.length} 个用例...`, 'info');\r\n      const res = await fetch('/api/execute/batch', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify(fileNames.map(f => ({ testCaseFileName: f })))\r\n      });\r\n      const result = await res.json();\r\n      if(Array.isArray(result)) {\r\n        const passed = result.filter(r => r.passed).length;\r\n        showStatusMessage(`批量执行完成: ${passed}/${result.length} 通过`, passed === result.length ? 'success' : 'warning');\r\n      }\r\n    } catch (e) {\r\n      showStatusMessage(\"批量执行请求失败\", 'error');\r\n    }\r\n  }\r\n\r\n  async function deleteTestCase(index) {\r\n    if(!confirm(\"确定删除此用例文件吗？\")) return;\r\n    const testCase = currentTestCases[index];\r\n    const cls = testCase.code.match(/public class (\\w+)/)[1] || `TestClass_${index+1}`;\r\n    const filePath = testCase.filePath || `case_generated/${scenarioName}/${cls}.java`;\r\n\r\n    try {\r\n      await fetch(`/api/testcase/deletefile?filepath=${encodeURIComponent(filePath)}`, { method: 'DELETE' });\r\n      currentTestCases.splice(index, 1);\r\n      setupPagination();\r\n      updateTestcaseStats(currentTestCases);\r\n      showStatusMessage(\"已删除\", \"success\");\r\n    } catch(e) {\r\n      showStatusMessage(\"删除失败: \" + e.message, 'error');\r\n    }\r\n  }\r\n\r\n  async function batchDeleteTestCases() {\r\n    const checkboxes = document.querySelectorAll('.testcase-checkbox:checked');\r\n    const indices = Array.from(checkboxes).map(cb => parseInt(cb.id.replace('checkbox-', ''))).sort((a,b)=>b-a);\r\n    if(indices.length === 0) return showStatusMessage(\"请先选择\", \"warning\");\r\n\r\n    if(!confirm(`确定删除选中的 ${indices.length} 个用例文件吗？`)) return;\r\n\r\n    const filePaths = indices.map(idx => {\r\n      const tc = currentTestCases[idx];\r\n      const cls = tc.code.match(/public class (\\w+)/)[1] || `TestClass_${idx+1}`;\r\n      return tc.filePath || `case_generated/${scenarioName}/${cls}.java`;\r\n    });\r\n\r\n    try {\r\n      const query = filePaths.map(p => `filepath=${encodeURIComponent(p)}`).join('&');\r\n      await fetch(`/api/testcase/deletefiles?${query}`, { method: 'DELETE' });\r\n\r\n      indices.forEach(idx => currentTestCases.splice(idx, 1));\r\n      setupPagination();\r\n      updateTestcaseStats(currentTestCases);\r\n      showStatusMessage(\"批量删除成功\", \"success\");\r\n    } catch(e) {\r\n      showStatusMessage(\"批量删除出错\", \"error\");\r\n    }\r\n  }\r\n\r\n  async function batchAnalyzeTestCases() {\r\n    const checkboxes = document.querySelectorAll('.testcase-checkbox:checked');\r\n    const selectedTestCases = Array.from(checkboxes).map(cb => currentTestCases[parseInt(cb.id.replace('checkbox-', ''))]);\r\n    if(selectedTestCases.length === 0) return showStatusMessage(\"请选择要分析的用例\", \"warning\");\r\n\r\n    showStatusMessage(\"正在进行 AI 分析...\", \"info\");\r\n    const allCode = selectedTestCases.map(tc => tc.code).join('\\n\\n');\r\n\r\n    try {\r\n      showLoading(true);\r\n      const res = await fetch('/api/testcase/analyze', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({\r\n          testCode: allCode,\r\n          testText: scenarioName,\r\n          apiDoc: ApiData_text ? JSON.stringify(ApiData_text) : '',\r\n          environment: '', dependency: ''\r\n        })\r\n      });\r\n      const data = await res.json();\r\n      if(!data.success) throw new Error(data.message);\r\n\r\n      const analysis = JSON.parse(data.analysis);\r\n      displayAnalysisResult(analysis);\r\n      showStatusMessage(\"分析完成\", \"success\");\r\n    } catch(e) {\r\n      showStatusMessage(\"分析失败: \" + e.message, \"error\");\r\n    } finally {\r\n      showLoading(false);\r\n    }\r\n  }\r\n\r\n  function displayAnalysisResult(analysis) {\r\n    document.getElementById('analysisSection').classList.remove('hidden');\r\n    document.getElementById('analysisSection').scrollIntoView({behavior: 'smooth'});\r\n\r\n    const metrics = analysis.metrics || {};\r\n    document.getElementById('totalLines').textContent = metrics.totalLines || metrics.total_lines || 0;\r\n    document.getElementById('testMethodCount').textContent = metrics.testMethodCount || metrics.test_method_count || 0;\r\n    document.getElementById('assertionCount').textContent = metrics.assertionCount || metrics.assertion_count || 0;\r\n    document.getElementById('coverageScoreDisplay').textContent = metrics.coverageScore || metrics.coverage_score || 0;\r\n\r\n    const list = document.getElementById('suggestionsList');\r\n    list.innerHTML = '';\r\n    const suggestions = analysis.suggestions || [];\r\n\r\n    if (suggestions.length === 0) {\r\n      list.innerHTML = '<li class=\"text-slate-400 italic text-center p-2\">AI 暂无优化建议 (代码质量良好或解析为空)</li>';\r\n    } else {\r\n      suggestions.forEach(s => {\r\n        const li = document.createElement('li');\r\n        li.className = \"flex items-start gap-2 bg-white/5 p-3 rounded border border-white/10\";\r\n        let content = '';\r\n        if (typeof s === 'string') {\r\n          content = s;\r\n        } else {\r\n          content = s.description || s.suggestion || s.problem_desc || s.desc || s.message || JSON.stringify(s);\r\n        }\r\n\r\n        let priorityBadge = '';\r\n        if (s.priority) {\r\n          const color = s.priority.toString().toLowerCase().includes('high') || s.priority.toString().includes('高') ? 'text-rose-400' : 'text-amber-400';\r\n          priorityBadge = `<span class=\"text-xs font-bold ${color} border border-current px-1 rounded mr-2 uppercase tracking-wider\">${s.priority}</span>`;\r\n        }\r\n\r\n        li.innerHTML = `<i class=\"fas fa-lightbulb text-yellow-400 mt-1 flex-shrink-0\"></i> <span class=\"text-sm text-slate-200 leading-relaxed\">${priorityBadge}${content}</span>`;\r\n        list.appendChild(li);\r\n      });\r\n    }\r\n  }\r\n\r\n  // --- 辅助工具函数 ---\r\n\r\n  function backToConfig() { navigateToStep(2); }\r\n\r\n  function updateScenarioName() {\r\n    const val = document.getElementById('scenarioNameInput').value.trim();\r\n    if(!val) return showStatusMessage(\"场景名不能为空\", \"error\");\r\n    scenarioName = val;\r\n    // 修改点：确保更新后的文本也包含“保存路径”前缀\r\n    document.getElementById('savePathPreview').innerHTML = `<i class=\"fas fa-folder text-amber-400\"></i> <span>保存路径: case_generated/${scenarioName}/</span>`;\r\n    document.getElementById('scenarioNameDisplay').textContent = scenarioName;\r\n    showStatusMessage(\"场景名已更新\", \"success\");\r\n  }\r\n\r\n  function editTestCase(index) {\r\n    document.getElementById(`code-view-${index}`).classList.add('hidden');\r\n    const editor = document.getElementById(`editor-${index}`);\r\n    editor.classList.remove('hidden');\r\n    editor.value = currentTestCases[index].code;\r\n    document.getElementById(`edit-actions-${index}`).classList.remove('hidden');\r\n    document.getElementById(`edit-actions-${index}`).classList.add('flex');\r\n  }\r\n  function saveTestCaseEdit(index) {\r\n    currentTestCases[index].code = document.getElementById(`editor-${index}`).value;\r\n    cancelTestCaseEdit(index);\r\n    updateTestcaseStats(currentTestCases);\r\n    showPage(currentPage);\r\n    showStatusMessage(\"已保存编辑内容 (未同步到服务器)\", \"info\");\r\n  }\r\n  function cancelTestCaseEdit(index) {\r\n    document.getElementById(`code-view-${index}`).classList.remove('hidden');\r\n    document.getElementById(`editor-${index}`).classList.add('hidden');\r\n    document.getElementById(`edit-actions-${index}`).classList.add('hidden');\r\n  }\r\n\r\n  function toggleCardStyle(checkbox) {\r\n    const card = checkbox.closest('.testcase-box');\r\n    if(checkbox.checked) { card.classList.add('border-indigo-500', 'ring-2', 'ring-indigo-500/20', 'shadow-lg'); card.classList.remove('border-slate-200', 'shadow-sm'); }\r\n    else { card.classList.remove('border-indigo-500', 'ring-2', 'ring-indigo-500/20', 'shadow-lg'); card.classList.add('border-slate-200', 'shadow-sm'); }\r\n  }\r\n  function escapeHtml(text) { return text.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\").replace(/'/g, \"&#039;\"); }\r\n\r\n  function setupPagination() {\r\n    const totalPages = Math.ceil(currentTestCases.length / casesPerPage);\r\n    const info = `第 ${currentPage} / ${totalPages} 页`;\r\n    document.getElementById('pageInfo').textContent = info;\r\n    document.getElementById('pageInfoBottom').textContent = info;\r\n    document.getElementById('paginationControlsBottom').style.display = totalPages > 1 ? 'flex' : 'none';\r\n    showPage(currentPage);\r\n  }\r\n  function showPage(page) {\r\n    document.getElementById('testcaseGrid').innerHTML = '';\r\n    const start = (page - 1) * casesPerPage;\r\n    for (let i = start; i < Math.min(start + casesPerPage, currentTestCases.length); i++) createTestCaseBox(currentTestCases[i], i);\r\n    updateSelectedCount();\r\n  }\r\n  function changePage(delta) {\r\n    const totalPages = Math.ceil(currentTestCases.length / casesPerPage);\r\n    const newPage = currentPage + delta;\r\n    if (newPage >= 1 && newPage <= totalPages) { currentPage = newPage; showPage(currentPage); document.getElementById('pageInfo').textContent = `第 ${currentPage} / ${totalPages} 页`; document.getElementById('pageInfoBottom').textContent = `第 ${currentPage} / ${totalPages} 页`; document.getElementById('selectAllCheckbox').checked = false; }\r\n  }\r\n  function toggleSelectAll() {\r\n    const checkAll = document.getElementById('selectAllCheckbox');\r\n    document.querySelectorAll('.testcase-checkbox').forEach(box => { box.checked = checkAll.checked; toggleCardStyle(box); });\r\n    updateSelectedCount();\r\n  }\r\n  function updateSelectedCount() { document.getElementById('selectedCount').textContent = `已选中 ${document.querySelectorAll('.testcase-checkbox:checked').length} 个`; }\r\n\r\n  function generateId() {\r\n    return 'testcase_' + Date.now() + '_' + Math.floor(Math.random() * 1000);\r\n  }\r\n\r\n  function showStatusMessage(message, type = 'info') {\r\n    const container = document.getElementById('toast-container');\r\n    const toast = document.createElement('div');\r\n    const styles = { success: 'bg-emerald-500 border-emerald-600', error: 'bg-rose-500 border-rose-600', warning: 'bg-amber-500 border-amber-600', info: 'bg-blue-500 border-blue-600' };\r\n    const icons = { success: 'fa-check-circle', error: 'fa-times-circle', warning: 'fa-exclamation-triangle', info: 'fa-info-circle' };\r\n    toast.className = `${styles[type]} border-l-4 text-white px-6 py-4 rounded-lg shadow-lg flex items-center gap-3 min-w-[300px] transform transition-all duration-300 translate-x-full opacity-0 pointer-events-auto`;\r\n    toast.innerHTML = `<i class=\"fas ${icons[type]} text-xl\"></i><span class=\"font-medium\">${message}</span>`;\r\n    container.appendChild(toast);\r\n    requestAnimationFrame(() => toast.classList.remove('translate-x-full', 'opacity-0'));\r\n    setTimeout(() => { toast.classList.add('opacity-0', 'translate-x-full'); setTimeout(() => toast.remove(), 300); }, 3500);\r\n  }\r\n\r\n  function showLoading(show = true) {\r\n    document.getElementById('loading-modal').classList.toggle('hidden', !show);\r\n  }\r\n\r\n  // --- 状态持久化 ---\r\n\r\n  function saveAppState() {\r\n    const state = {\r\n      step: 3,\r\n      allApiData: allApiData,\r\n      ApiData_text: ApiData_text,\r\n      currentTestCases: currentTestCases,\r\n      generatedTestData: generatedTestData,\r\n      scenarioName: scenarioName,\r\n    };\r\n    sessionStorage.setItem('autoTestState', JSON.stringify(state));\r\n  }\r\n\r\n  function restoreAppState() {\r\n    try {\r\n      const savedJson = sessionStorage.getItem('autoTestState');\r\n      if (!savedJson) return;\r\n\r\n      const state = JSON.parse(savedJson);\r\n\r\n      allApiData = state.allApiData || [];\r\n      ApiData_text = state.ApiData_text;\r\n      currentTestCases = state.currentTestCases || [];\r\n      generatedTestData = state.generatedTestData;\r\n      scenarioName = state.scenarioName || \"search_chats_api\";\r\n\r\n      if(allApiData.length > 0) renderTable();\r\n\r\n      document.getElementById('scenarioNameInput').value = scenarioName;\r\n\r\n      if (state.step === 3 && currentTestCases.length > 0) {\r\n        navigateToStep(3); // 使用新的导航逻辑\r\n\r\n        updateTestcaseStats(currentTestCases);\r\n        document.getElementById('scenarioInfoPanel').classList.remove('hidden');\r\n        document.getElementById('scenarioNameDisplay').textContent = scenarioName;\r\n\r\n        const pos = currentTestCases.filter(tc => !tc.code.includes(\"Negative\")).length;\r\n        document.getElementById('positiveCases').textContent = pos;\r\n        document.getElementById('totalTestCases').textContent = currentTestCases.length;\r\n\r\n        document.getElementById('selectAllContainer').classList.remove('hidden');\r\n        setupPagination();\r\n\r\n        showStatusMessage(\"已恢复上次生成的结果\", \"info\");\r\n      }\r\n    } catch (e) {\r\n      console.error(\"恢复状态失败\", e);\r\n      sessionStorage.removeItem('autoTestState');\r\n    }\r\n  }\r\n\r\n</script>\r\n</body>\r\n</html>
