    "PositiveCases": [
        {
            "CaseName": "正向用例_获取群成员列表_默认参数",
            "Steps": [
                {
                    "StepID": 1,
                    "Description": "使用默认参数获取群成员列表",
                    "Method": "GET",
                    "Path": "/chats/{chat_id}/members",
                    "Input": {
                        "PathParams": {
                            "chat_id": "oc_a0553eda9014c201e6969b478895c230"
                        },
                        "QueryParams": {
                            "member_id_type": "open_id",
                            "page_size": 20
                        },
                        "Headers": {
                            "Authorization": "Bearer <valid_access_token>"
                        }
                    },
                    "Expectations": [
                        "状态码为200",
                        "响应体code字段为0",
                        "响应体msg字段为'success'",
                        "响应体data.items为数组",
                        "响应体data.items数组中的每个对象包含member_id_type、member_id、name、tenant_key字段",
                        "响应体data.has_more为布尔值",
                        "响应体data.member_total为整数"
                    ],
                    "DataMapping": {
                        "说明": "此接口返回的成员列表（data.items）可用于后续业务操作，例如：1. 根据member_id向特定成员发送消息。2. 根据member_id_type和member_id进行用户信息查询或权限校验。3. 根据tenant_key进行跨租户业务逻辑判断（如仅处理同租户成员）。"
                    }
                }
            ],
            "ExpectedResults": [
                "成功获取到群成员列表，返回数据符合预期结构",
                "分页信息正确，可根据has_more和page_token进行后续分页查询"
            ]
        },
        {
