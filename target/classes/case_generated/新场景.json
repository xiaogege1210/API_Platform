{
    "ScenarioName": "新场景-获取群成员列表",
    "Prerequisites": [
        "应用已开启机器人能力",
        "操作者（机器人或用户）必须在被查询的群组内",
        "已获取有效的访问令牌（tenant_access_token 或 user_access_token）"
    ],
    "PositiveCases": [
        {
            "CaseName": "正向用例-获取群成员列表（默认参数）",
            "Steps": [
                {
                    "StepID": 1,
                    "Description": "调用获取群成员列表接口，使用默认参数",
                    "Method": "GET",
                    "Path": "/chats/{chat_id}/members",
                    "Input": {
                        "path": {
                            "chat_id": "oc_a0553eda9014c201e6969b478895c230"
                        },
                        "query": {
                            "member_id_type": "open_id",
                            "page_size": 20
                        },
                        "headers": {
                            "Authorization": "Bearer <valid_access_token>"
                        }
                    },
                    "Expectations": [
                        "状态码为200",
                        "响应体code字段为0",
                        "响应体msg字段为'success'",
                        "响应体data.items为数组类型",
                        "每个items元素包含member_id_type、member_id、name、tenant_key字段",
                        "data.has_more为布尔类型",
                        "data.member_total为整数类型"
                    ],
                    "DataMapping": {
                        "description": "接口返回的成员列表数据（items）可用于后续业务场景，例如：1. 群成员分析：统计群内活跃用户、成员构成等。2. 消息定向发送：基于member_id向特定成员发送消息。3. 权限校验：校验某个用户是否为群成员。4. 分页处理：如果has_more为true，可使用返回的page_token作为下一次请求的参数，继续获取剩余成员。"
                    }
                }
            ],
            "ExpectedResults": [
                "成功获取到群成员列表信息",
                "返回数据符合ChatMember对象结构",
                "分页信息正确"
            ]
        },
        {
            "CaseName": "正向用例-获取群成员列表（指定user_id类型）",
            "Steps": [
                {
                    "StepID": 1,
                    "Description": "调用获取群成员列表接口，指定member_id_type为user_id",
                    "Method": "GET",
                    "Path": "/chats/{chat_id}/members",
                    "Input": {
                        "path": {
                            "chat_id": "oc_a0553eda9014c201e6969b478895c230"
                        },
                        "query": {
                            "member_id_type": "user_id",
                            "page_size": 50
                        },
                        "headers": {
                            "Authorization": "Bearer <valid_access_token>"
                        }
                    },
                    "Expectations": [
                        "状态码为200",
                        "响应体code字段为0",
                        "响应体msg字段为'success'",
                        "响应体data.items为数组类型",
                        "每个items元素的member_id_type字段值为'user_id'",
                        "data.has_more为布尔类型",
                        "data.member_total为整数类型"
                    ],
                    "DataMapping": {
                        "description": "返回的user_id类型成员信息可用于需要员工ID的业务场景，例如：1. 与HR系统对接，关联员工信息。2. 权限管理：基于user_id进行更精确的权限控制。3. 内部系统集成：企业内其他系统通常使用user_id作为用户标识。"
                    }
                }
            ],
            "ExpectedResults": [
                "成功获取到user_id类型的群成员列表",
                "返回的member_id_type字段值为user_id",
                "分页参数生效"
            ]
        },
        {
            "CaseName": "正向用例-获取群成员列表（使用page_token分页）",
            "Steps": [
                {
                    "StepID": 1,
                    "Description": "调用获取群成员列表接口，使用page_token进行分页查询",
                    "Method": "GET",
                    "Path": "/chats/{chat_id}/members",
                    "Input": {
                        "path": {
                            "chat_id": "oc_a0553eda9014c201e6969b478895c230"
                        },
                        "query": {
                            "member_id_type": "open_id",
                            "page_size": 10,
                            "page_token": "WWxHTStrOEs5WHZpNktGbU94bUcvMWlxdDUzTWt1OXNrRmlLaGRNVG0yaz0="
                        },
                        "headers": {
                            "Authorization": "Bearer <valid_access_token>"
                        }
                    },
                    "Expectations": [
                        "状态码为200",
                        "响应体code字段为0",
                        "响应体msg字段为'success'",
                        "响应体data.items为数组类型",
                        "data.page_token字段存在（可能为null或新token）",
                        "data.has_more为布尔类型"
                    ],
                    "DataMapping": {
                        "description": "分页查询返回的数据可用于：1. 大数据量场景下的分批处理，避免单次请求数据量过大。2. 增量同步：基于page_token实现群成员的增量获取。3. 性能优化：控制单次请求的数据量，提升响应速度。"
                    }
                }
            ],
            "ExpectedResults": [
                "成功使用page_token进行分页查询",
                "返回正确的分页数据",
                "分页机制正常工作"
            ]
        }
    ],
    "NegativeCases": [
        {
            "CaseName": "异常用例-无效的群ID",
            "Steps": [
                {
                    "StepID": 1,
                    "Description": "调用获取群成员列表接口，使用无效的chat_id",
                    "Method": "GET",
                    "Path": "/chats/{chat_id}/members",
                    "Input": {
                        "path": {
